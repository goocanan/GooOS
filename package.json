{
  "name": "gooos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@gooos/api",
    "dev:web": "npm run dev --workspace=@gooos/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed --workspace=@gooos/api",
    "smoke": "npm run smoke --workspace=@gooos/api",
    "verify": "npm run smoke --workspace=@gooos/api && npm run verify:boot --workspace=@gooos/api"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}