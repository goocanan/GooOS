# Copy to apps/api/.env and adjust. Every value below is optional in development;
# the defaults let the API boot with an embedded database and mock AI.

# --- server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- database ---
# Leave DATABASE_URL empty to use the embedded PGlite database (no install).
# Set it to a Neon/Supabase connection string to use a real Postgres server -
# the schema and every query are portable, so nothing else changes.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Where PGlite stores its data directory.
PGLITE_DIR=.data/gooos

# --- storage ---
# Directory for uploaded asset blobs. Stands in for S3/Supabase Storage (PRD 16).
STORAGE_DIR=storage

# Public base URL of the API, used to build asset URLs.
API_PUBLIC_URL=http://localhost:4000

# --- cors ---
# Origins allowed to send credentialed requests (the Vite dev server).
CORS_ORIGINS=http://localhost:5180,http://localhost:5173

# --- auth (PRD 38) ---
# Must be at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-before-deploying
BETTER_AUTH_URL=http://localhost:4000

# --- seed ---
# true creates the demo account and fixtures on boot if they do not exist.
SEED_DEMO_USER=true

# --- AI assistant (PRD 27/28) ---
# mock   = deterministic local generator, always available, no network
# openai = real LLM call (requires OPENAI_API_KEY)
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_CREDITS_PER_RUN=2
