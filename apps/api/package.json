{
  "name": "@gooos/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "smoke": "node --import tsx src/smoke.ts",
    "verify:boot": "node verify-boot.mjs",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node --import tsx -e \"import('./src/db/migrate.js').then(m => m.dropAll()).then(() => console.log('schema dropped'))\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@gooos/shared": "*",
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "~5.9.3"
  }
}
